{
  "name": "ocs",
  "version": "0.0.1",
  "description": "OpenCode Sandbox - run OpenCode in an OS-level sandbox",
  "main": "dist/index.js",
  "bin": {
    "ocs": "./dist/cli.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:int": "vitest run --config vitest.integration.config.ts",
    "dev": "tsx src/cli.ts",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\""
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "opencode",
    "sandbox",
    "bubblewrap",
    "srt"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "0.0.77",
    "commander": "^14.0.0",
    "zod": "^4.1.9"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.5.2",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
